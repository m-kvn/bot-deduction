# ---------------------------------------------------------------------------
# Bot_Deduction / bot-signal form demo — runtime configuration
# Copy to .env and adjust. Every variable is optional; the defaults shown here
# are what the app uses when the variable is unset.
# ---------------------------------------------------------------------------

# --- Demo server (bot-signal/examples/form-demo/server.mjs) ----------------

# HTTP port the form + dashboard listen on.
PORT=8787

# Interface to bind to. Defaults to 127.0.0.1 (loopback only), so the app is reachable
# solely through a reverse proxy / tunnel on the same host. Set to 0.0.0.0 to listen on
# every interface -- required inside Docker, and only safe with TRUST_EDGE_HEADERS unset.
HOST=127.0.0.1

# SQLite file for submissions. Use :memory: for an ephemeral store.
# DB_FILE=./bot-signal/examples/form-demo/submissions.db

# Set to 1 ONLY when the app runs behind a proxy/CDN you control. It makes the
# server trust x-forwarded-proto, the client-IP header, and the TLS/crawler
# headers below. Leave unset when the app is exposed directly — otherwise any
# caller can spoof their IP and TLS fingerprint.
# TRUST_EDGE_HEADERS=1

# Header your edge writes the real visitor IP into. Only read when
# TRUST_EDGE_HEADERS=1. Common values: x-forwarded-for, cf-connecting-ip,
# x-real-ip, true-client-ip.
# CLIENT_IP_HEADER=x-forwarded-for

# Require a TLS fingerprint (x-ja4 / x-ja3-hash from the edge) on every
# submission. Browser traffic without one is then treated as suspicious.
# REQUIRE_TLS=1

# Comma-separated JA3/JA4 hashes to treat as known-bad.
# SUSPICIOUS_TLS=

# Same as above but as JSON, so each entry can carry a label and score.
# SUSPICIOUS_TLS_ENTRIES=[{"fingerprint":"<ja4>","label":"curl-impersonate","score":0.9}]

# Allowed drift, in minutes, between the browser clock and the GeoIP timezone
# before the mismatch is noted. 180 covers US cross-zone travel.
# TZ_TOLERANCE_MINUTES=180

# --- Proof of work ---------------------------------------------------------
# Each challenge carries a hash puzzle. The base cost is what every visitor pays;
# escalation only begins past MAX_SUBMISSIONS_PER_IP so a shared office address is
# not punished for being busy.

# Leading zero bits required at the base difficulty (~0.12s).
# POW_BASE_DIFFICULTY=16

# Bits added per submission beyond MAX_SUBMISSIONS_PER_IP.
# POW_ESCALATION_BITS=2

# Ceiling (~7.5s at 22 bits).
# POW_MAX_DIFFICULTY=22

# --- Telemetry beacons -----------------------------------------------------
# The page reports every few seconds over a nonce chain, and the server times the
# arrivals on its own clock. A claimed observation window must be matched by the
# session having actually reported across it.

# How often the page beacons.
# TELEMETRY_INTERVAL_MS=2000

# Fraction of the claimed observation window the beacons must cover.
# TELEMETRY_COVERAGE=0.5

# How stale the last beacon may be at submit time.
# TELEMETRY_STALE_MS=20000

# --- Volume and repetition controls ----------------------------------------
# These never change the verdict. They decide `outcome`: a submission scored
# human that also looks like a loop returns outcome=review (HTTP 202) instead of
# being accepted silently. This is the layer that covers OS-level scan-code
# injection and raw CDP input, which a browser cannot distinguish from a person.

# Rolling window for every counter below, in milliseconds.
# RISK_WINDOW_MS=600000

# Submissions allowed from one page load before it reads as a loop.
# MAX_SUBMISSIONS_PER_SESSION=3

# Submissions allowed from one IP inside the window.
# MAX_SUBMISSIONS_PER_IP=10

# Page loads allowed from one IP inside the window.
# MAX_SESSIONS_PER_IP=12

# Challenges one page load may take (the page pre-fetches one per submit).
# MAX_CHALLENGES_PER_SESSION=24

# How often identical form content may arrive from one IP before review.
# MAX_IDENTICAL_SUBMISSIONS=1

# --- Bot simulators (bot-signal/examples/form-demo/bots/*.mjs) -------------

# Target the simulated bots point at.
# DEMO_URL=http://localhost:8787

# Run browser-bot.mjs with a visible window instead of headless.
# HEADFUL=1

# User-Agent script-bot.mjs sends.
# BOT_UA=python-requests/2.32.3
