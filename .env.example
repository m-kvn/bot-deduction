# ---------------------------------------------------------------------------
# Bot_Deduction / bot-signal form demo — runtime configuration
# Copy to .env and adjust. Every variable is optional; the defaults shown here
# are what the app uses when the variable is unset.
# ---------------------------------------------------------------------------

# --- Demo server (bot-signal/examples/form-demo/server.mjs) ----------------

# HTTP port the form + dashboard listen on.
PORT=8787

# SQLite file for submissions. Use :memory: for an ephemeral store.
# DB_FILE=./bot-signal/examples/form-demo/submissions.db

# Set to 1 ONLY when the app runs behind a proxy/CDN you control. It makes the
# server trust x-forwarded-proto, the client-IP header, and the TLS/crawler
# headers below. Leave unset when the app is exposed directly — otherwise any
# caller can spoof their IP and TLS fingerprint.
# TRUST_EDGE_HEADERS=1

# Header your edge writes the real visitor IP into. Only read when
# TRUST_EDGE_HEADERS=1. Common values: x-forwarded-for, cf-connecting-ip,
# x-real-ip, true-client-ip.
# CLIENT_IP_HEADER=x-forwarded-for

# Require a TLS fingerprint (x-ja4 / x-ja3-hash from the edge) on every
# submission. Browser traffic without one is then treated as suspicious.
# REQUIRE_TLS=1

# Comma-separated JA3/JA4 hashes to treat as known-bad.
# SUSPICIOUS_TLS=

# Same as above but as JSON, so each entry can carry a label and score.
# SUSPICIOUS_TLS_ENTRIES=[{"fingerprint":"<ja4>","label":"curl-impersonate","score":0.9}]

# Allowed drift, in minutes, between the browser clock and the GeoIP timezone
# before the mismatch is noted. 180 covers US cross-zone travel.
# TZ_TOLERANCE_MINUTES=180

# --- Bot simulators (bot-signal/examples/form-demo/bots/*.mjs) -------------

# Target the simulated bots point at.
# DEMO_URL=http://localhost:8787

# Run browser-bot.mjs with a visible window instead of headless.
# HEADFUL=1

# User-Agent script-bot.mjs sends.
# BOT_UA=python-requests/2.32.3
